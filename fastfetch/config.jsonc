{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/master/doc/json_schema.json",
  "modules": [
    "title",
    "separator",
    {
      "type": "os",
      "format": "{3} {12}"
    },
    {
      "type": "host",
      "format": "{2}"
    },
    "kernel",
    "uptime",
    "packages",
    "shell",
    "de",
    "wm",
    "terminal",
    "cpu",
    {
      "type": "gpu",
      "hideType": "integrated",
      "format": "{2}"
    },
    "memory",
    "disk",
    "break",
  ]
}

